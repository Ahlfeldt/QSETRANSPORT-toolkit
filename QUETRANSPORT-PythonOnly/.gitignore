__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# MATLAB
*.asv
*.m~
*.mex*
slprj/

# LaTeX auxiliaries; retain source and released PDF
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.synctex.gz
docs/*.fls
docs/*.fdb_latexmk

