.idea/
.vscode/
.spyproject/
.DS_Store
Thumbs.db
desktop.ini

# Generated inputs and products
input/standardized/**
outputs/**

# Retain directory skeletons
!input/raw/**/.gitkeep
!input/standardized/**/.gitkeep
!input/standardized/README.md
!outputs/**/.gitkeep
!outputs/README.md

# GIS working files
*.shp.xml
*.qix
*.sbn
*.sbx
*.gpkg-wal
*.gpkg-shm

# Retain the spatial index supplied with the bundled reference network
!input/raw/networks/counterfactual/CRL-line.qix
