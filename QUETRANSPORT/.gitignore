.vscode/
.spyproject/
.DS_Store
Thumbs.db
desktop.ini

# User data and generated products
input/raw/**
input/standardized/**
outputs/**

# Retain directory skeletons
!input/raw/**/.gitkeep
!input/standardized/**/.gitkeep
!outputs/**/.gitkeep

